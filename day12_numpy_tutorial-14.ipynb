   ],
   "source": [
    "marks = np.array([10,20,30])\n",
    "mean = np.mean(marks)\n",
    "std_dev = np.std(marks)\n",
    "\n",
    "normalized = (marks - mean)/std_dev\n",
    "\n",
    "print(\"1. Mean (Average): \",mean)\n",
    "print(\"2. Standard Deviation:\", std_dev)\n",
    "print(\"3. Normalized Array:\", normalized)\n",
    "\n"
   ]
